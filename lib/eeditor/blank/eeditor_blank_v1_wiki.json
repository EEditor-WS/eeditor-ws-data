{
  "eeditor": {
    "allowHtml": true,
    "description": "<style>\n:root{--bg:#0f1419;--bg2:#1a2029;--bg3:#232b38;--acc:#ff6b35;--acc2:#f7931e;--txt:#e6e6e6;--dim:#9aa4b2;--brd:#2d3748;--ok:#4ade80;--err:#ef4444;--info:#60a5fa}\n[data-theme=light]{--bg:#f5f5f0;--bg2:#fff;--bg3:#e8e8e0;--acc:#c2410c;--acc2:#b45309;--txt:#1a1a1a;--dim:#555;--brd:#d4d4c8}\n*{box-sizing:border-box;margin:0;padding:0}\n.wiki-root{font-family:Georgia,serif;background:var(--bg);color:var(--txt);line-height:1.6;display:flex;min-height:100vh}\n.sidebar{width:280px;background:var(--bg2);border-right:2px solid var(--brd);padding:20px;position:sticky;top:0;height:100vh;overflow-y:auto;flex-shrink:0}\n.sidebar h1{font-size:22px;color:var(--acc);margin-bottom:6px;letter-spacing:1px;border-bottom:2px solid var(--acc);padding-bottom:8px}\n.sidebar .sub{font-size:12px;color:var(--dim);margin-bottom:20px;font-style:italic}\n.search{width:100%;padding:8px 12px;background:var(--bg3);border:1px solid var(--brd);border-radius:4px;color:var(--txt);margin-bottom:16px;font-family:inherit}\n.search:focus{outline:2px solid var(--acc)}\n.nav-sec{margin-bottom:18px}\n.nav-sec h3{font-size:11px;text-transform:uppercase;color:var(--dim);letter-spacing:2px;margin-bottom:8px}\n.nb{display:block;width:100%;text-align:left;padding:8px 12px;background:0 0;border:0;color:var(--txt);cursor:pointer;border-radius:4px;font-family:inherit;font-size:14px;margin-bottom:2px;transition:.2s;border-left:3px solid transparent}\n.nb:hover{background:var(--bg3);border-left-color:var(--acc2)}\n.nb.act{background:var(--bg3);border-left-color:var(--acc);color:var(--acc);font-weight:700}\n.main{flex:1;padding:40px 60px;max-width:1100px;overflow-x:hidden}\n.page{display:none;animation:fi .4s}\n.page.act{display:block}\n@keyframes fi{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}\n.page h1{font-size:36px;color:var(--acc);margin-bottom:8px;border-bottom:3px double var(--acc);padding-bottom:12px}\n.page h2{font-size:24px;color:var(--acc2);margin:24px 0 12px;border-left:4px solid var(--acc);padding-left:12px}\n.page h3{font-size:18px;margin:18px 0 8px}\n.page p{margin-bottom:12px}\n.hero{background:linear-gradient(135deg,var(--bg2),var(--bg3));border:1px solid var(--brd);border-radius:8px;padding:24px;margin-bottom:24px;border-left:5px solid var(--acc)}\n.hero .yr{font-size:48px;color:var(--acc);font-weight:700;letter-spacing:4px}\n.hero .tl{font-style:italic;color:var(--dim);font-size:16px}\n.sg{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:20px 0}\n.sc{background:var(--bg2);border:1px solid var(--brd);border-radius:6px;padding:16px;text-align:center}\n.sc .n{font-size:32px;color:var(--acc);font-weight:700}\n.sc .l{font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:1px}\n.cg{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin:16px 0}\n.cc{background:var(--bg2);border:1px solid var(--brd);border-radius:6px;padding:14px;cursor:pointer;transition:.25s;border-top:3px solid var(--acc)}\n.cc:hover{transform:translateY(-3px);box-shadow:0 6px 16px rgba(255,107,53,.2);border-top-color:var(--acc2)}\n.cc .cn{font-size:16px;font-weight:700;color:var(--acc);margin-bottom:4px}\n.cc .ci{font-size:11px;color:var(--dim);font-family:monospace;margin-bottom:8px}\n.cc .cd{font-size:13px;line-height:1.5}\n.tag{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;margin-right:4px;margin-bottom:4px;background:var(--bg3);color:var(--dim);border:1px solid var(--brd)}\n.tag.w{background:rgba(239,68,68,.2);color:var(--err);border-color:var(--err)}\n.tag.d{background:rgba(96,165,250,.2);color:var(--info);border-color:var(--info)}\n.tag.e{background:rgba(74,222,128,.2);color:var(--ok);border-color:var(--ok)}\n.tag.ev{background:rgba(247,147,30,.2);color:var(--acc2);border-color:var(--acc2)}\n.tl{position:relative;padding-left:30px;margin:20px 0}\n.tl::before{content:'';position:absolute;left:8px;top:0;bottom:0;width:2px;background:var(--acc)}\n.ti{position:relative;margin-bottom:20px;padding:12px 16px;background:var(--bg2);border:1px solid var(--brd);border-radius:6px}\n.ti::before{content:'';position:absolute;left:-27px;top:18px;width:12px;height:12px;border-radius:50%;background:var(--acc);border:2px solid var(--bg)}\n.ti .tt{font-weight:700;color:var(--acc);margin-bottom:4px}\n.ti .tb{font-size:14px}\n.mc{background:var(--bg2);border:1px solid var(--brd);border-radius:8px;padding:18px;margin-bottom:14px}\n.mc h3{color:var(--acc);margin-bottom:8px;display:flex;align-items:center;gap:8px}\n.mc .ic{display:inline-block;width:28px;height:28px;background:var(--acc);color:var(--bg);border-radius:50%;text-align:center;line-height:28px;font-weight:700}\nblockquote{border-left:4px solid var(--acc2);padding:10px 16px;margin:12px 0;background:var(--bg2);font-style:italic;color:var(--dim);border-radius:0 4px 4px 0}\n.spoiler{background:var(--bg3)!important;color:var(--bg3)!important;padding:2px 6px;border-radius:3px;cursor:pointer;user-select:none;transition:.3s}\n.spoiler.rev{background:rgba(255,107,53,.15)!important;color:var(--txt)!important}\n.ttb{position:fixed;bottom:20px;right:20px;width:48px;height:48px;border-radius:50%;background:var(--acc);color:var(--bg);border:0;cursor:pointer;font-size:20px;box-shadow:0 4px 12px rgba(0,0,0,.3);z-index:100}\n.fb{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}\n.fbtn{padding:6px 12px;background:var(--bg2);border:1px solid var(--brd);color:var(--txt);border-radius:16px;cursor:pointer;font-family:inherit;font-size:13px;transition:.2s}\n.fbtn:hover{border-color:var(--acc)}\n.fbtn.act{background:var(--acc);color:var(--bg);border-color:var(--acc)}\n.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;align-items:center;justify-content:center;padding:20px}\n.modal.open{display:flex}\n.mcont{background:var(--bg2);border:1px solid var(--brd);border-radius:8px;padding:24px;max-width:600px;width:100%;max-height:80vh;overflow-y:auto;border-top:4px solid var(--acc)}\n.mcl{float:right;background:0 0;border:0;color:var(--txt);font-size:24px;cursor:pointer}\n@media(max-width:768px){.wiki-root{flex-direction:column}.sidebar{width:100%;height:auto;position:relative}.main{padding:20px}}\n</style>\n\n<div class=\"wiki-root\">\n  <aside class=\"sidebar\">\n    <h1>⚔ GNW WIKI</h1>\n    <div class=\"sub\">The Great New World · v0.7</div>\n    <input type=\"text\" class=\"search\" id=\"srch\" placeholder=\"🔍 Поиск...\">\n    <div class=\"nav-sec\">\n      <h3>Разделы</h3>\n      <button class=\"nb act\" data-p=\"home\">🏠 Главная</button>\n      <button class=\"nb\" data-p=\"countries\">🏛 Государства</button>\n      <button class=\"nb\" data-p=\"timeline\">📜 Хроника</button>\n      <button class=\"nb\" data-p=\"mech\">⚙ Механики</button>\n      <button class=\"nb\" data-p=\"crises\">🔥 Кризисы</button>\n      <button class=\"nb\" data-p=\"lore\">📚 Лор</button>\n    </div>\n    <div class=\"nav-sec\">\n      <h3>Ключевые державы</h3>\n      <button class=\"nb\" data-c=\"civilization_26\">Орденштайн Меттенберг</button>\n      <button class=\"nb\" data-c=\"civilization_61\">Орден Спасения Бавии</button>\n      <button class=\"nb\" data-c=\"civilization_54\">ВКАБ</button>\n      <button class=\"nb\" data-c=\"civilization_2\">Вторая Республика Метта</button>\n      <button class=\"nb\" data-c=\"civilization_3\">Респ. Большой Гондриции</button>\n      <button class=\"nb\" data-c=\"civilization_49\">АСР / ЮСРБ</button>\n      <button class=\"nb\" data-c=\"civilization_51\">Синяя Колона</button>\n      <button class=\"nb\" data-c=\"civilization_52\">Свободная Армия Бавии</button>\n      <button class=\"nb\" data-c=\"civilization_56\">Империя Сев. Алескана</button>\n      <button class=\"nb\" data-c=\"civilization_1\">Империя Эндерск</button>\n    </div>\n  </aside>\n\n  <main class=\"main\">\n    <section class=\"page act\" id=\"p-home\">\n      <h1>The Great New World</h1>\n      <div class=\"hero\">\n        <div class=\"yr\">1847</div>\n        <div class=\"tl\">«Эра нового мира. Гиганты восстали, империи пали, история пишется кровью».</div>\n        <p style=\"margin-top:12px\">Глобальная альтернативно-историческая стратегия в сеттинге вымышленного континента. Десятки фракций, идеологий и сюжетных линий переплетаются в борьбе за объединение Бавии, выживание малых наций и передел мира после Второго Великого конфликта.</p>\n      </div>\n      <div class=\"sg\">\n        <div class=\"sc\"><div class=\"n\">~250</div><div class=\"l\">Событий</div></div>\n        <div class=\"sc\"><div class=\"n\">100+</div><div class=\"l\">Государств</div></div>\n        <div class=\"sc\"><div class=\"n\">1847</div><div class=\"l\">Год начала</div></div>\n        <div class=\"sc\"><div class=\"n\">v0.7</div><div class=\"l\">Версия</div></div>\n      </div>\n      <h2>⚡ Ключевые конфликты</h2>\n      <div class=\"mc\"><h3><span class=\"ic\">1</span> Кризис Лагмании</h3><p>Бывшее «второе сердце экономики мира» охвачено гражданской войной. Обвал биржи в Барборросии запустил цепную реакцию — мир катится в глобальный экономический кризис.</p></div>\n      <div class=\"mc\"><h3><span class=\"ic\">2</span> Борьба за Бавию</h3><p>На территории бывшей единой Бавии столкнулись десятки фракций. Орденштайн, Орден Спасения, ВКАБ, Синяя Колона, Свободная Армия — каждая преследует свою цель объединения.</p></div>\n      <div class=\"mc\"><h3><span class=\"ic\">3</span> Гражданская война в Гондриции</h3><p>После убийства диктатора Республика Большой Гондриции — некогда великая держава — погружается в хаос. Столица и Антиреволюционный Конгресс в Курхе рвутся к власти.</p></div>\n      <h2>🎮 Как пользоваться вики</h2>\n      <p>Используйте <b>боковое меню</b> для перехода между разделами. В разделе <b>«Государства»</b> нажмите на карточку, чтобы узнать подробности. Включите <b>поиск</b>, чтобы быстро найти нужное событие или страну. Кнопка <b>🌙/☀</b> в правом нижнем углу переключает тему оформления.</p>\n    </section>\n\n    <section class=\"page\" id=\"p-countries\">\n      <h1>🏛 Государства мира</h1>\n      <p>Полный каталог стран, фракций и движений, участвующих в событиях сценария.</p>\n      <div class=\"fb\" id=\"fbar\">\n        <button class=\"fbtn act\" data-f=\"all\">Все</button>\n        <button class=\"fbtn\" data-f=\"major\">Великие державы</button>\n        <button class=\"fbtn\" data-f=\"bav\">Бавийские фракции</button>\n        <button class=\"fbtn\" data-f=\"gond\">Гондриция</button>\n        <button class=\"fbtn\" data-f=\"lagm\">Лагмания</button>\n        <button class=\"fbtn\" data-f=\"emp\">Империи</button>\n        <button class=\"fbtn\" data-f=\"minor\">Малые страны</button>\n        <button class=\"fbtn\" data-f=\"anarchy\">Анархия</button>\n      </div>\n      <div class=\"cg\" id=\"cgrid\"></div>\n    </section>\n\n    <section class=\"page\" id=\"p-timeline\">\n      <h1>📜 Хроника событий</h1>\n      <p>Ключевые эвенты сценария в хронологическом порядке.</p>\n      <div class=\"tl\" id=\"tl\"></div>\n    </section>\n\n    <section class=\"page\" id=\"p-mech\">\n      <h1>⚙ Игровые механики</h1>\n      <div class=\"mc\"><h3><span class=\"ic\">₽</span> Регуляция страны</h3><p>Изменяйте законы, тратя <b>Престиж</b>. Доступны три сферы:</p><p><span class=\"tag e\">Экономика</span> <b>Плановая</b> — бонусы к развитию. <b>Смешанная</b> — помощь народу. <b>Капитализм</b> — рост богатства.</p><p><span class=\"tag w\">Армия</span> <b>Минимум / Средне / Максимум</b> — лимит дивизий.</p></div>\n      <div class=\"mc\"><h3><span class=\"ic\">⚔</span> Военные заказы</h3><p>Воинские корпорации присылают предложения: флот, танки, артиллерия. Всего <b>6 военных заказов</b> с нарастающей стоимостью.</p></div>\n      <div class=\"mc\"><h3><span class=\"ic\">★</span> Борьба за влияние</h3><p>Механика мирного объединения Бавии. <b>Синяя Колона</b> и <b>Свободная Армия</b> стартуют с <b>0 очков</b>. Задача — набрать <b>10 очков</b> раньше противника.</p></div>\n      <div class=\"mc\"><h3><span class=\"ic\">$</span> Инфляция</h3><p>При накоплении денег срабатывает механика: <b>Инфляция I → Гиперинфляция</b>. Каждая стадия обесценивает бюджет.</p></div>\n      <div class=\"mc\"><h3><span class=\"ic\">⚡</span> План «Востон»</h3><p>Трёхэтапный план ВКАБ: <b>Электрификация → Индустриализация → Обеспечение народа</b>. Аналогичные планы: «Белоннштайн», «Прироун», «Реньатом».</p></div>\n      <div class=\"mc\"><h3><span class=\"ic\">☠</span> Дипломатия ботов</h3><p>Опциональная настройка: включать ли ИИ-дипломатию. Боты заключают союзы, торговые пакты и объявляют войны по собственным сценариям.</p></div>\n    </section>\n\n    <section class=\"page\" id=\"p-crises\">\n      <h1>🔥 Кризисы и войны</h1>\n      <div class=\"mc\"><h3><span class=\"ic\">⚠</span> Кризис Лагмании (1847)</h3><p>Полгода гражданской войны. Обвал биржи в Барборросии → глобальный экономический кризис.</p><span class=\"tag e\">Экономика</span><span class=\"tag w\">Война</span></div>\n      <div class=\"mc\"><h3><span class=\"ic\">⚔</span> Война в Метте</h3><p>Меттенберг и Метэния без объявления войны вторгаются во Вторую Республику Метта. Цель Метэнии — захват портов и соединение с ПКБП.</p><span class=\"tag w\">Война</span></div>\n      <div class=\"mc\"><h3><span class=\"ic\">🏛</span> Гражданская война в Гондриции</h3><p>Убийство диктатора Фенгона во время речи раскалывает республику. В Курхе основан Антиреволюционный Конгресс.</p><span class=\"tag w\">Война</span><span class=\"tag ev\">Сюжет</span></div>\n      <div class=\"mc\"><h3><span class=\"ic\">☠</span> Имперская война (Алескан)</h3><p>Террористы Синей Колоны поднимают бунт на юге Империи Северного Алескана. Операция «Оверблу» — удар верных дивизий.</p><span class=\"tag w\">Война</span></div>\n      <div class=\"mc\"><h3><span class=\"ic\">⚠</span> Рейд с пустоши «Озёр»</h3><p>Разбойники с «озёр» совершают рейд на земли Ордена Спасения. Инцидент поднимает вопрос о плане 1837 года.</p><span class=\"tag ev\">Сюжет</span></div>\n      <div class=\"mc\"><h3><span class=\"ic\">⚔</span> Развал Восточной Барборросии</h3><p>Восстания на землях Восточной Барборросии. Регион почти не контролируется метрополией.</p><span class=\"tag w\">Война</span></div>\n      <div class=\"mc\"><h3><span class=\"ic\">⚔</span> Меттенберг в Гондриции</h3><p>Орденштайн вторгается в Гондрицию во время её гражданской войны. Заявляет о полном присоединении земель.</p><span class=\"tag w\">Война</span></div>\n    </section>\n\n    <section class=\"page\" id=\"p-lore\">\n      <h1>📚 Лор и история</h1>\n      <h2>Мир после Второго Великого конфликта</h2>\n      <p>1847 год. Две мировые войны перекроили карту: одни империи возвысились, другие исчезли. Санкции, репарации, блокады — наследие прошлого определяет границы и экономику новых государств.</p>\n      <h2>Великая Нация Меттенберга</h2>\n      <p>Орденштайн Меттенберг возник в 1834 году после восстания против РБГ. Лидер — <b>Хенренн</b>. Официальная идеология: <i>«Наш народ — лучший из возможных. Есть лишь несколько подобных нам — в Лиге, в Лагмании. Но никто не станет истинным Меттенцем, если не родился им»</i>.</p>\n      <h2>Тайна Меттов</h2>\n      <p><span class=\"spoiler\" onclick=\"this.classList.toggle('rev')\">«Метты никогда не существовало, это лишь ложь. Это были повстанцы, которые не хотели принять верный путь. Теперь они будут стёрты с истории нашего государства».</span></p>\n      <h2>Покушение на Регента</h2>\n      <p>Святой Регент Ордена Спасения ехал в Озерс. При входе в здание пуля попала ему в плечо. Убийца пойман почти на месте выстрела — выяснилось, что он с востока. После этого Регент объявил о начале второго этапа объединения Бавии. <span class=\"spoiler\" onclick=\"this.classList.toggle('rev')\">В апреле начнётся война.</span></p>\n      <h2>Судьба Фенгона</h2>\n      <p>Президент Гондриции Фенгон был убит во время войны на два фронта. Пуля попала в плечо, когда он заходил в здание в Озерске. После этого в стране началась анархия: «Фенгон умер, а значит мы остались без правителя... Убийства, кражи, стычки — и всё это в самой столице».</p>\n      <h2>План «Красный Коготь»</h2>\n      <p>Секретный план наступления, разработанный Генерал-главнокомандующим Лирнорием. Нападение с севера, быстрый прорыв через линии обороны, взятие столицы. Война начинается через три месяца после активации плана.</p>\n      <h2>План «Реньатом»</h2>\n      <p><span class=\"spoiler\" onclick=\"this.classList.toggle('rev')\">Секретный проект Орденштайна по созданию ядерной бомбы. Цель — окончательно укрепить державу и продолжить уничтожение «неполноценных» народов.</span></p>\n      <h2>Бавия: осколки единства</h2>\n      <p>Ещё недавно единая Бавия теперь разделена на десятки осколков: от коммунистической ВКАБ на востоке до монархического Ордена Спасения в Фонрене, от радикальной Синей Колоны до таинственной Лиги на юге. Объединение — главная цель каждой фракции, но пути к нему разные: дипломатия, влияние, штыки.</p>\n      <h2>Июльские выборы в Метте</h2>\n      <p>После смерти диктатора Эмнерона — возвращение демократии. На выборах победили кандидаты от КПМ, СРМ и ДПМ. Победил кандидат от ДПМ — приверженец реформ и восстановления демократии. Он планирует примирить отношения с Метэнией и начать развивать торговлю с Гальском и Барборросией.</p>\n      <h2>Связи с Эндерском</h2>\n      <p>Династия Алесканцев имела связи в Эндерске ещё со времён Империи. Попытка завлечь инвестиции увенчалась успехом — теперь появилась возможность торговать в важном хабе Восэнда.</p>\n      <h2>Новый Великий порт</h2>\n      <p>С давних пор Фонрен считался лучшим портом всех Бавийцев. Но сейчас он под контролем ордена, заявляющего о своей официальности. Орден Спасения строит «Новый Фонрен» для развития торговли и промышленности.</p>\n    </section>\n  </main>\n</div>\n\n<button class=\"ttb\" id=\"ttb\" title=\"Сменить тему\">🌙</button>\n\n<div class=\"modal\" id=\"mod\">\n  <div class=\"mcont\">\n    <button class=\"mcl\" onclick=\"document.getElementById('mod').classList.remove('open')\">×</button>\n    <div id=\"mb\"></div>\n  </div>\n</div>\n\n<script>\n(function(){\nconst C=[\n{i:'civilization_26',n:'Орденштайн Меттенберг',c:'major',d:'Радикальный национализм, тоталитаризм. Лидер — Хенренн. Использует рабов, планирует «Реньатом» (ядерная бомба). Считает себя «великой нацией».',t:['w','totalitarian']},\n{i:'civilization_61',n:'Орден Спасения Бавии',c:'bav',d:'Легитимное правительство бывшей Бавии. Контролирует Фонрен. Цель — воссоединение страны. Во главе — Святой Регент.',t:['d','monarchy']},\n{i:'civilization_54',n:'Восточная Коммунистическая Армия Бавии (ВКАБ)',c:'bav',d:'Коммунистический оплот на востоке. Реализует план «Востон»: электрификация → индустриализация → обеспечение народа.',t:['e','communist']},\n{i:'civilization_2',n:'Вторая Республика Метта',c:'major',d:'Потерянное государство. После Второй Великой Войны — под санкциями Эндерска, в блокаде Метэнии. Президент — Хековск.',t:['e','survival']},\n{i:'civilization_3',n:'Республика Большой Гондриции',c:'gond',d:'Великая держава, «вторая экономика старого света». После убийства диктатора — в гражданской войне.',t:['w','crisis']},\n{i:'civilization_49',n:'Алесканская Социалистическая Республика (АСР/ЮСРБ)',c:'bav',d:'Оплот на юге Бавии. Лидер — Лирнорий. Позже переименована в Южную Социалистическую Республику Бавии.',t:['communist']},\n{i:'civilization_51',n:'Армия Синей Колоны',c:'bav',d:'Демократическая, но «слишком мирная» фракция. Борется за влияние со Свободной Армией за объединение Бавии.',t:['d']},\n{i:'civilization_52',n:'Свободная Армия Бавии',c:'bav',d:'Юго-восточное подразделение, осевшее в Востоне. Прошла через сектантов Багора. Борется за влияние.',t:['d']},\n{i:'civilization_56',n:'Империя Северного Алескана',c:'emp',d:'Династия Алесканцев. Император — Кирилл VII. Столица — Алескан. Борется с террористами Синей Колоны.',t:['monarchy','w']},\n{i:'civilization_50',n:'Правительство Лиги в Бавии',c:'bav',d:'Таинственный оплот «Великой Идеи» — объединения мира под знамёна Лиги. Дивизия «Лига» — их элита.',t:['ev']},\n{i:'civilization_1',n:'Империя Эндерск',c:'emp',d:'Крупнейшая империя старого света. Контролирует Восэнд — важный торговый хаб.',t:['d']},\n{i:'civilization_5',n:'Империя Барборросия',c:'emp',d:'Обвал биржи в этой стране запустил мировой кризис. Контролирует часть спорных земель.',t:['e']},\n{i:'civilization_33',n:'Государство Метэния',c:'major',d:'Сосед и соперник Метты. Контролирует ключевые порты. Вступила в войну против Второй Республики.',t:['w']},\n{i:'civilization_7',n:'Гальская СДР',c:'minor',d:'Социал-демократическая республика. Важный торговый партнёр, через её порты идёт торговля.',t:['d','e']},\n{i:'civilization_16',n:'Республика Лагмания',c:'lagm',d:'Бывшее «второе сердце экономики мира». Охвачена гражданской войной. Потеряла остров Северниан.',t:['w','crisis']},\n{i:'civilization_46',n:'Республика Бавия',c:'bav',d:'Миролюбивая страна. «Мы не хотим воевать». Стала жертвой тёмного террора с юга.',t:['minor']},\n{i:'civilization_69',n:'Анархия',c:'anarchy',d:'После смерти Фенгона страна погрузилась в хаос. «Убийства, кражи, стычки — и всё это в столице».',t:['crisis']},\n{i:'civilization_47',n:'Царство Бавия',c:'bav',d:'Монархическое образование на юге. Стало целью АСР в походе на объединение.',t:['monarchy']},\n{i:'civilization_70',n:'Антиреволюционный Конгресс',c:'gond',d:'Оппозиционное правительство в Курхе. Противостоит столице во время гражданской войны в Гондриции.',t:['w']},\n{i:'civilization_88',n:'Республика Вальтерия',c:'minor',d:'Новое государство, появившееся после раздела Метты. Планирует объединение с Меттой в 1851 году.',t:['d']},\n{i:'civilization_58',n:'Анархия на землях Озёр',c:'anarchy',d:'Разбойники с «озёр», совершающие рейды на соседние земли.',t:['w']},\n{i:'civilization_89',n:'Энделмаркс',c:'minor',d:'«Ужасные людишки», создавшие государство Барборросов на старых землях Меттенберга. Цель Хенренна — покарать их.',t:['w']},\n{i:'civilization_92',n:'Свободный Конгресс Гондриции',c:'gond',d:'Одна из фракций в расколотой Гондриции. Борется за свободу после падения диктатуры.',t:['w']},\n{i:'civilization_97',n:'Нацистский Совет Гондриции',c:'gond',d:'Радикальная группировка, возникшая в хаосе гражданской войны.',t:['w']},\n{i:'civilization_55',n:'Республика Батвия',c:'bav',d:'Небавийский народ, исторически находившийся в составе Бавии. Орден Спасения ведёт переговоры о присоединении.',t:['d']},\n{i:'civilization_53',n:'Фонреаль',c:'bav',d:'Важный город на востоке Бавии. ВКАБ ведёт с ним переговоры об объединении.',t:['d']},\n{i:'civilization_84',n:'Республика Антаст',c:'minor',d:'Бывший союзник ВКАБ. Разорвал связи — ВКАБ планирует захват.',t:['w']},\n{i:'civilization_98',n:'Коммунистическая Армия Гондриции',c:'gond',d:'Одна из фракций в расколотой Гондриции.',t:['w','communist']},\n{i:'civilization_68',n:'Новое Правительство Лагмании',c:'lagm',d:'Альтернативное правительство в охваченной войной Лагмании.',t:['crisis']},\n{i:'civilization_62',n:'Старое Правительство Лагмании',c:'lagm',d:'Легитимное правительство Лагмании до начала гражданской войны.',t:['crisis']},\n{i:'civilization_64',n:'Западные Коммуны Лагмании',c:'lagm',d:'Коммунистическая фракция в расколотой Лагмании.',t:['w','communist']},\n{i:'civilization_66',n:'Коммунистическая Лига Лагмании',c:'lagm',d:'Ещё одна коммунистическая группировка в Лагмании.',t:['communist']},\n{i:'civilization_63',n:'Острова Свободы',c:'minor',d:'Островное государство, претензии на которое имеют несколько держав.',t:['d']},\n{i:'civilization_25',n:'Республика Островов Айсерска',c:'minor',d:'Островная республика.',t:['minor']},\n{i:'civilization_8',n:'Свободная Армия Айсерска',c:'minor',d:'Военизированная группировка на островах Айсерска.',t:['w']},\n{i:'civilization_9',n:'Империя Вязанкиния',c:'emp',d:'Одна из империй старого света.',t:['emp']},\n{i:'civilization_6',n:'Великолукская Уния',c:'minor',d:'Союзное государство.',t:['minor']},\n{i:'civilization_21',n:'Великовольфенский Штайн',c:'minor',d:'Небольшое государство.',t:['minor']},\n{i:'civilization_4',n:'Союз Республик Натегона',c:'minor',d:'Союзное образование.',t:['minor']},\n{i:'civilization_10',n:'Соединённые Штаты Янгуссонии',c:'minor',d:'Республиканское государство.',t:['minor']},\n{i:'civilization_15',n:'Южная Провинция Янгуссонии',c:'minor',d:'Провинция, отколовшаяся от СШЯ.',t:['minor']},\n{i:'civilization_11',n:'Соединённые Штаты Таркии',c:'minor',d:'Республика.',t:['minor']},\n{i:'civilization_27',n:'Республика Таркия',c:'minor',d:'Ещё одно таркийское государство.',t:['minor']},\n{i:'civilization_13',n:'Объединённые Провинции Кошкении',c:'minor',d:'Провинциальное образование.',t:['minor']},\n{i:'civilization_28',n:'Республика Кошкенианских Провинций',c:'minor',d:'Альтернативная кошкенианская республика.',t:['minor']},\n{i:'civilization_80',n:'Правительство Кошкении',c:'minor',d:'Центральное правительство.',t:['minor']},\n{i:'civilization_12',n:'Автономная Республика Гонлоров',c:'minor',d:'Автономия гонлоров.',t:['minor']},\n{i:'civilization_30',n:'Штат Гонлоров',c:'minor',d:'Штат гонлоров.',t:['minor']},\n{i:'civilization_44',n:'Центральная Армия Гонлоров',c:'minor',d:'Военизированная группировка.',t:['w']},\n{i:'civilization_42',n:'Вторая Коммуна Гонлоров',c:'minor',d:'Коммуна.',t:['minor']},\n{i:'civilization_43',n:'Федерация Гонлоров',c:'minor',d:'Федеративное образование.',t:['minor']},\n{i:'civilization_29',n:'Округ Гонло-Зявнор',c:'minor',d:'Округ.',t:['minor']},\n{i:'civilization_78',n:'Ярония',c:'minor',d:'Государство яронов.',t:['minor']},\n{i:'civilization_31',n:'Штат Ярония',c:'minor',d:'Штат.',t:['minor']},\n{i:'civilization_93',n:'Штат Янвения',c:'minor',d:'Штат.',t:['minor']},\n{i:'civilization_14',n:'Восточно-Яронская Провинция',c:'minor',d:'Провинция.',t:['minor']},\n{i:'civilization_79',n:'Коммуны Яронов',c:'minor',d:'Коммуны.',t:['minor']},\n{i:'civilization_87',n:'Освободительная Армия Лафии',c:'minor',d:'Военизированная группировка.',t:['w']},\n{i:'civilization_19',n:'Республика Лафия',c:'minor',d:'Республика.',t:['minor']},\n{i:'civilization_18',n:'Республика Лориум',c:'minor',d:'Признала ВСРБ.',t:['d']},\n{i:'civilization_86',n:'Государство Лориштайн',c:'minor',d:'Небольшое государство.',t:['minor']},\n{i:'civilization_20',n:'Республика Лавольфов',c:'minor',d:'Республика.',t:['minor']},\n{i:'civilization_41',n:'Штайн Лавольфов',c:'minor',d:'Штайн.',t:['minor']},\n{i:'civilization_22',n:'Государство Фолоров',c:'minor',d:'Государство.',t:['minor']},\n{i:'civilization_32',n:'Государство Котерния',c:'minor',d:'Государство.',t:['minor']},\n{i:'civilization_94',n:'Республика Райтак',c:'minor',d:'Республика.',t:['minor']},\n{i:'civilization_17',n:'Государство Бобертия',c:'minor',d:'Государство.',t:['minor']},\n{i:'civilization_34',n:'Внешняя Бобертия',c:'minor',d:'Внешние земли Бобертии.',t:['minor']},\n{i:'civilization_45',n:'Округ Энделмаркса',c:'minor',d:'Округ.',t:['minor']},\n{i:'civilization_37',n:'Имперская Барборрия Проденск',c:'emp',d:'Провинция Барборросии.',t:['emp']},\n{i:'civilization_35',n:'Имперская Барборрия Нарон',c:'emp',d:'Провинция Барборросии.',t:['emp']},\n{i:'civilization_95',n:'Имперская Восточная Барборросия',c:'emp',d:'Восточные земли Барборросии, охваченные восстаниями.',t:['w','emp']},\n{i:'civilization_36',n:'ВМФ Барбаского Залива',c:'minor',d:'Военно-морские силы.',t:['w']},\n{i:'civilization_48',n:'Дивизия Бавгон',c:'minor',d:'Военизированная группировка.',t:['w']},\n{i:'civilization_67',n:'Города Консессии',c:'minor',d:'Концессионные города.',t:['minor']},\n{i:'civilization_71',n:'Нац-Освободительная Армия',c:'minor',d:'Партизанская группировка.',t:['w']},\n{i:'civilization_99',n:'Армия свободных народов',c:'minor',d:'Коалиция.',t:['w']},\n{i:'civilization_96',n:'Группировка Реншолгер',c:'minor',d:'Группировка.',t:['w']},\n{i:'civilization_81',n:'Группа ОАК «Север»',c:'minor',d:'Северная группировка.',t:['w']},\n{i:'civilization_82',n:'Группа ОАК «Запад»',c:'minor',d:'Западная группировка.',t:['w']},\n{i:'civilization_72',n:'Южное Управление',c:'minor',d:'Управление.',t:['minor']},\n{i:'civilization_73',n:'Революционный Фронт',c:'minor',d:'Фронт.',t:['w']},\n{i:'civilization_74',n:'Свободный Город Фенеск',c:'minor',d:'Город-государство.',t:['minor']},\n{i:'civilization_75',n:'Ганчжлор',c:'minor',d:'Небольшое государство.',t:['minor']},\n{i:'civilization_76',n:'Ранчлорин',c:'minor',d:'Государство.',t:['minor']},\n{i:'civilization_77',n:'Менил-Ра',c:'minor',d:'Государство.',t:['minor']},\n{i:'civilization_57',n:'Ранлония',c:'minor',d:'Мелкий варлорд, сопротивляющийся АСР.',t:['w']},\n{i:'civilization_85',n:'Свободная Армия Нарона',c:'minor',d:'Армия.',t:['w']},\n{i:'civilization_90',n:'Восэнд',c:'minor',d:'Важный торговый хаб Эндерска.',t:['e']},\n{i:'civilization_91',n:'Энглавская Республика',c:'minor',d:'Республика.',t:['minor']},\n{i:'civilization_38',n:'Серный Округ Безопасности',c:'minor',d:'Округ.',t:['minor']},\n{i:'civilization_39',n:'Регион Линорсия',c:'minor',d:'Регион.',t:['minor']},\n{i:'civilization_83',n:'Провинция Иьест-Кош',c:'minor',d:'Провинция.',t:['minor']},\n{i:'civilization_23',n:'Город Гроур',c:'minor',d:'Город-государство.',t:['minor']},\n{i:'civilization_24',n:'Гроурская Компания',c:'minor',d:'Корпоративное государство.',t:['e']},\n{i:'civilization_40',n:'Штайн Лафиу',c:'minor',d:'Штайн.',t:['minor']},\n{i:'civilization_59',n:'Северный Флот Бавии',c:'bav',d:'Военно-морские силы.',t:['w']},\n{i:'civilization_60',n:'Пограничье Батвии',c:'bav',d:'Пограничные земли.',t:['minor']},\n{i:'civilization_65',n:'Крестьянская Свободная Армия',c:'minor',d:'Крестьянская армия.',t:['w']},\n{i:'civilization_100',n:'Республика Линдония',c:'minor',d:'Создана Эндерском для поддержки амбиций в Бавии. Захвачена Батвией и Эндерском.',t:['minor']},\n{i:'civilization_101',n:'Ячейка 0',c:'anarchy',d:'Подпольная ячейка.',t:['w']},\n{i:'civilization_102',n:'Ячейка 1',c:'anarchy',d:'Подпольная ячейка.',t:['w']},\n{i:'civilization_103',n:'Ячейка 2',c:'anarchy',d:'Подпольная ячейка.',t:['w']},\n{i:'civilization_104',n:'Ячейка 3',c:'anarchy',d:'Подпольная ячейка.',t:['w']},\n{i:'civilization',n:'Бавийский Союз Социалистических Республик',c:'bav',d:'Историческое государство, предшественник ВКАБ. Проиграло войну и распалось.',t:['history']}\n];\nconst T=[\n{y:'1834',t:'Основание Орденштайна',b:'Орденштайн Меттенберг возникает после восстания против РБГ. Начало существования «тёмного осколка» Бавии.'},\n{y:'1835',t:'Орден Спасения Бавии',b:'Образование легитимного правительства в Фонрене. Начало подготовки к воссоединению страны.'},\n{y:'1837',t:'План против пиратов',b:'Орден Спасения ставит план борьбы с пиратством, ставший актуальным после рейда с «озёр».'},\n{y:'1842',t:'Репрессии в Орденштайне',b:'Часть элиты пытается свергнуть режим Хенренна. После провала — жестокие чистки среди лучших солдат.'},\n{y:'1847, начало',t:'Кризис Лагмании',b:'Гражданская война во втором сердце мировой экономики. Обвал биржи в Барборросии запускает мировой кризис.'},\n{y:'1847',t:'Убийство диктатора Гондриции',b:'Президент Фенгон убит во время речи. Страна погружается в хаос. В Курхе основан Антиреволюционный Конгресс.'},\n{y:'1847',t:'Война в Метте',b:'Меттенберг и Метэния вторгаются во Вторую Республику Метта без объявления войны. Начало большой войны.'},\n{y:'1847',t:'Покушение на Регента',b:'Святой Регент Ордена Спасения ранен в Озерске. Объявлен второй этап объединения Бавии.'},\n{y:'1847',t:'Июльские выборы в Метте',b:'После смерти диктатора Эмнерона — возвращение демократии. Побеждает кандидат ДПМ, курс на реформы.'},\n{y:'1847',t:'Меттенберг в Гондриции',b:'Орденштайн вторгается в Гондрицию во время её гражданской войны и заявляет о полном присоединении земель.'},\n{y:'1847',t:'Взрыв в Фонрене',b:'В столице Ордена Спасения взорвано здание, где бывает Святой Регент. 13 погибших, 38 пострадавших. Подозревают ВКАБ.'},\n{y:'1848',t:'Имперская война в Алескане',b:'Бунт Синей Колоны на юге Империи Северного Алескана. Операция «Оверблу» — удар верных дивизий.'},\n{y:'1848',t:'Эвенты Синей Колоны и САБ',b:'Продолжение борьбы за влияние. Эвенты обеих фракций разворачиваются параллельно.'},\n{y:'1849, лето',t:'Поход на Запад (АСР)',b:'ЮСРБ начинает наступление на Республику Бавия в Арноле.'},\n{y:'1851',t:'Объединение Метты и Вальтерии',b:'После трёх этапов переговоров — подписание договора. Два разделённых народа снова едины.'}\n];\nconst D={\n'civilization_26':'Орденштайн Меттенберг — «великая нация» под руководством Хенренна. Радикальный национализм, тоталитаризм, использование рабов. Планирует ядерный проект «Реньатом» и полное уничтожение «неполноценных» народов. Считает меттов выдумкой, их историю — ложью. В 1842 году часть элиты пыталась свергнуть режим — после провала жестокие репрессии среди лучших солдат.',\n'civilization_61':'Орден Спасения Бавии — легитимное правительство бывшей Бавии. Образован в 1835 году. Контролирует сердце страны — Фонрен. Святой Регент правит до объединения, после чего обещает передать власть императору. Ведёт борьбу с пиратами, планирует «Новый Фонрен». Переговоры с Батвией о присоединении. Встреча в Крандо с Эндерском.',\n'civilization_54':'Восточная Коммунистическая Армия Бавии (ВКАБ) — один из двух оплотов легитимной власти БССР. Реализует план «Востон» (электрификация → индустриализация → обеспечение народа). Позже восстанавливается как ВСРБ. Округа: Востон, Антаст, Фонреаль. Признание от Королевства Лориум и ГСДР.',\n'civilization_2':'Вторая Республика Метта (Лимето) — потерянное государство. Пережило золотой век в 13-15 вв., падение в 1749, возрождение и поражение во Второй Великой Войне. Под санкциями Эндерска, в блокаде Метэнии. Президент — Хековск. После победы над Меттенбергом — переговоры с Вальтерией об объединении.',\n'civilization_3':'Республика Большой Гондриции — «великая экономика старого света», второе место в мире по ВВП. После убийства диктатора Фенгона — в гражданской войне. Столица против Курха. Соседи посматривают на её земли. Недавний кризис из-за гражданской войны в Лагмании подкосил популярность правительства.',\n'civilization_49':'Алесканская Социалистическая Республика (позже ЮСРБ) — оплот на юге Бавии. Лидер — Генерал-главнокомандующий Лирнорий. Прошла путь от АСР до объединения юга и похода на Республику. План «Красный Коготь» — наступление с севера.',\n'civilization_51':'Синяя Колона — демократическая фракция, борющаяся с имперцами Алескана. «Слишком мирная для этого мира». Ведёт борьбу за влияние со Свободной Армией за будущее объединённой Бавии. План: уничтожить имперцев, помочь САБ, затем жить в мире.',\n'civilization_52':'Свободная Армия Бавии — юго-восточное подразделение, осевшее в Востоне. Прошла через конфликт с сектантами Багора. Борется за влияние с Синей Колоной. Развивает Багор и индустриализацию. Союз с Синей Колоной.',\n'civilization_56':'Империя Северного Алескана — династия Алесканцев. Император — Кирилл VII. Столица — Алескан. Борется с террористами Синей Колоны. Покушение на императора — три выстрела, один в руку. Операция «Оверблу» — удар по повстанцам.',\n'civilization_50':'Правительство Лиги в Бавии — таинственный оплот «Великой Идеи» объединения мира под знамёна Лиги. Дивизия «Лига» — их элита. Проблема: народ ещё не посвящён в великую идею.',\n'civilization_1':'Империя Эндерск — крупнейшая империя старого света. Контролирует Восэнд — важный торговый хаб. Накладывала санкции на Метту. Встреча в Крандо с Орденом Спасения.',\n'civilization_5':'Империя Барборросия — обвал биржи в этой стране запустил мировой кризис. Контролирует часть спорных земель. Восточная Барборросия охвачена восстаниями.',\n'civilization_33':'Государство Метэния — сосед и соперник Метты. Контролирует ключевые порты. Вступила в войну против Второй Республики, захватывает порты для соединения с ПКБП. Имеет связи с Орденштайном, но те молчат.',\n'civilization_7':'Гальская СДР — социал-демократическая республика. Важный торговый партнёр. Через её порты Метта ведёт торговлю. Помогает ВКАБ закупать станки.',\n'civilization_16':'Республика Лагмания — бывшее «второе сердце экономики мира». Охвачена гражданской войной. Потеряла остров Северниан во время войны против коалиции. Сейчас на Северниане беженцы из Лагмании.',\n'civilization_46':'Республика Бавия — миролюбивая страна. «Мы не хотим воевать». Стала жертвой тёмного террора с юга (дивизии Гондриции совершают набеги).',\n'civilization_69':'Анархия — после смерти Фенгона страна погрузилась в хаос. «Убийства, кражи, стычки — и всё это в столице».',\n'civilization_47':'Царство Бавия — монархическое образование на юге. Стало целью АСР в походе на объединение. Стычка у Южноцарска — АСР случайно дошла до их территории.',\n'civilization_70':'Антиреволюционный Конгресс — оппозиционное правительство в Курхе. Основан почти сразу после убийства Фенгона. Противостоит столице во время гражданской войны.',\n'civilization_88':'Республика Вальтерия — новое государство, появившееся после раздела Метты. Планирует объединение с Меттой в 1851 году. Три этапа переговоров.',\n'civilization_58':'Анархия на землях Озёр — разбойники с «озёр», совершающие рейды на земли Ордена Спасения. Инцидент поднял вопрос о плане 1837 года.',\n'civilization_89':'Энделмаркс — «ужасные людишки», создавшие государство Барборросов на старых землях Меттенберга. Хенренн: «Пора покарать их за это!»',\n'civilization_92':'Свободный Конгресс Гондриции — одна из фракций в расколотой Гондриции. Борется за свободу после падения диктатуры.',\n'civilization_97':'Нацистский Совет Гондриции — радикальная группировка, возникшая в хаосе гражданской войны.',\n'civilization_55':'Республика Батвия — небавийский народ, исторически находившийся в составе Бавии. Орден Спасения ведёт три этапа переговоров о присоединении. В итоге — автономия и полное присоединение.',\n'civilization_53':'Фонреаль — важный город на востоке Бавии. ВКАБ ведёт с ним переговоры об объединении. После падения — ассимиляция земель.',\n'civilization_84':'Республика Антаст — бывший союзник ВКАБ. Разорвал связи — ВКАБ планирует захват в ближайшие месяцы.',\n'civilization_98':'Коммунистическая Армия Гондриции — одна из фракций в расколотой Гондриции.',\n'civilization_68':'Новое Правительство Лагмании — альтернативное правительство в охваченной войной Лагмании. Встреча в Востоне с ВКАБ о передаче территорий.',\n'civilization_62':'Старое Правительство Лагмании — легитимное правительство Лагмании до начала гражданской войны.',\n'civilization_64':'Западные Коммуны Лагмании — коммунистическая фракция в расколотой Лагмании.',\n'civilization_66':'Коммунистическая Лига Лагмании — ещё одна коммунистическая группировка в Лагмании.',\n'civilization_95':'Имперская Восточная Барборросия — восточные земли Барборросии, охваченные восстаниями. Регион почти не контролируется метрополией.',\n'civilization_100':'Республика Линдония — создана Эндерском для поддержки амбиций в Бавии. Спустя долгое время выяснилось, что они держат позиции плохо. При вводе войск Батвии Эндерск захватил часть земель себе.',\n'civilization':'Бавийский Союз Социалистических Республик (БССР) — историческое государство, предшественник ВКАБ. Проиграло войну, погрузилось в анархию и тьму. Востон и несколько городов были частично с током, но за время анархии всё пострадало.'\n};\nconst g=document.getElementById('cgrid');\nfunction rc(f='all',s=''){\n  g.innerHTML='';\n  const fl=C.filter(c=>{\n    if(f!=='all'&&c.c!==f)return false;\n    if(s&&!c.n.toLowerCase().includes(s)&&!c.d.toLowerCase().includes(s))return false;\n    return true;\n  });\n  if(!fl.length){g.innerHTML='<p style=\"color:var(--dim);grid-column:1/-1;text-align:center;padding:40px\">Ничего не найдено</p>';return}\n  fl.forEach(c=>{\n    const d=document.createElement('div');\n    d.className='cc';\n    d.innerHTML='<div class=\"cn\">'+c.n+'</div><div class=\"ci\">'+c.i+'</div><div class=\"cd\">'+c.d+'</div>';\n    d.onclick=()=>op(c);\n    g.appendChild(d);\n  });\n}\nrc();\nfunction op(c){\n  const m=document.getElementById('mod'),b=document.getElementById('mb');\n  const ex=D[c.i]||'';\n  b.innerHTML='<h1 style=\"font-size:24px;color:var(--acc);margin-bottom:8px\">'+c.n+'</h1><div style=\"font-family:monospace;color:var(--dim);margin-bottom:16px\">'+c.i+'</div><p>'+c.d+'</p>'+(ex?'<h3 style=\"margin-top:16px;color:var(--acc2)\">Подробности</h3><p>'+ex+'</p>':'');\n  m.classList.add('open');\n}\nconst tl=document.getElementById('tl');\nT.forEach(e=>{\n  const d=document.createElement('div');\n  d.className='ti';\n  d.innerHTML='<div class=\"tt\">'+e.y+' — '+e.t+'</div><div class=\"tb\">'+e.b+'</div>';\n  tl.appendChild(d);\n});\ndocument.querySelectorAll('.nb[data-p]').forEach(b=>{\n  b.onclick=()=>{\n    document.querySelectorAll('.nb').forEach(x=>x.classList.remove('act'));\n    b.classList.add('act');\n    document.querySelectorAll('.page').forEach(p=>p.classList.remove('act'));\n    document.getElementById('p-'+b.dataset.p).classList.add('act');\n    window.scrollTo(0,0);\n  };\n});\ndocument.querySelectorAll('.nb[data-c]').forEach(b=>{\n  b.onclick=()=>{\n    const c=C.find(x=>x.i===b.dataset.c);\n    if(c){\n      document.querySelectorAll('.nb').forEach(x=>x.classList.remove('act'));\n      document.querySelector('.nb[data-p=countries]').classList.add('act');\n      document.querySelectorAll('.page').forEach(p=>p.classList.remove('act'));\n      document.getElementById('p-countries').classList.add('act');\n      op(c);\n    }\n  };\n});\ndocument.querySelectorAll('.fbtn').forEach(b=>{\n  b.onclick=()=>{\n    document.querySelectorAll('.fbtn').forEach(x=>x.classList.remove('act'));\n    b.classList.add('act');\n    rc(b.dataset.f,document.getElementById('srch').value.toLowerCase());\n  };\n});\ndocument.getElementById('srch').oninput=e=>{\n  const af=document.querySelector('.fbtn.act').dataset.f;\n  rc(af,e.target.value.toLowerCase());\n};\nconst tb=document.getElementById('ttb');\ntb.onclick=()=>{\n  const r=document.documentElement;\n  if(r.dataset.theme==='light'){r.dataset.theme='';tb.textContent='🌙'}\n  else{r.dataset.theme='light';tb.textContent='☀'}\n};\ndocument.getElementById('mod').onclick=e=>{\n  if(e.target.id==='mod')e.target.classList.remove('open');\n};\n})();\n</script>"
  }
}